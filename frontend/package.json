{
  "name": "waytogo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write app components lib tests *.ts *.mts *.mjs *.js",
    "format:check": "prettier --check app components lib tests *.ts *.mts *.mjs *.js"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "axe-core": "4.14.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.0",
    "postcss": "^8",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9",
    "vitest": "^4.0.0"
  }
}
